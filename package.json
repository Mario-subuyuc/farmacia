{
  "name": "site",
  "version": "1.0.0",
  "description": "API MVC para una cadena de farmacias con Supabase y PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:check": "node scripts/check-database.js",
    "ui:install": "npm --prefix frontend install",
    "ui": "npm --prefix frontend run dev",
    "ui:build": "npm --prefix frontend run build",
    "ui:test": "npm --prefix frontend test",
    "test": "node --test tests/*.test.js",
    "jobs:check": "node scripts/maintenance.js",
    "jobs:run": "node scripts/maintenance.js --run",
    "emails:run": "node scripts/process-emails.js",
    "db:backup": "node scripts/backup.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "morgan": "^1.12.1",
    "nodemailer": "^10.1.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
