digraph BD { graph [rankdir=LR,bgcolor="white",pad="0.5",nodesep="0.45",ranksep="1.25",splines=polyline,outputorder=edgesfirst]; node [shape=plain,fontname="Arial",fontsize=11]; edge [fontname="Arial",fontsize=9,color="#718397",arrowsize=0.65];
