PORT=3000
# Solo backend. Necesaria para que ADMIN cree cuentas con correo y contraseña.
SUPABASE_SECRET_KEY=
# Seeder del primer administrador: configura una contraseña propia antes de db:seed.
ADMIN_SEED_EMAIL=mariosubuyucfb@gmail.com
ADMIN_SEED_NAME=Mario
ADMIN_SEED_PASSWORD=
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu-clave-publicable
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Solo para migraciones y seeders; nunca enviar esta URL al frontend.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Servir también el frontend compilado desde Express
SERVE_FRONTEND=false
# Expirar reservas de pedidos PENDIENTES a las dos horas (revisión cada minuto)
EXPIRATION_JOB_ENABLED=true
# Avisos externos: configurar únicamente cuando exista un adaptador/proveedor
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# Correo SMTP (solo backend; nunca incluir en frontend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TEST_TO=
ALERT_EMAIL_TO=
# Activar solo después de comprobar la autenticación y el destinatario
EMAIL_WORKER_ENABLED=false

# Direccion publica para enlaces de confirmacion de actividades
PUBLIC_SITE_URL=http://localhost:5173
